{
  "name": "llm-redact",
  "version": "1.1.0",
  "description": "A local proxy that redacts API keys, tokens and personal data from your AI agent's requests before they leave your machine, and restores them in the responses. Claude Code, Codex, OpenCode, DeepSeek. Zero dependencies.",
  "keywords": [
    "llm",
    "proxy",
    "redaction",
    "secrets",
    "pii",
    "privacy",
    "dlp",
    "claude-code",
    "codex",
    "deepseek",
    "anthropic",
    "openai",
    "security"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zch6a/llm-redact.git"
  },
  "homepage": "https://github.com/zch6a/llm-redact#readme",
  "bugs": {
    "url": "https://github.com/zch6a/llm-redact/issues"
  },
  "type": "module",
  "bin": {
    "llm-redact": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/COMPATIBILITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "node src/bin.ts",
    "test": "node --import ./test/isolate.ts --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "check": "npm run typecheck && npm test",
    "smoke": "node scripts/smoke.ts",
    "soak": "node --expose-gc scripts/soak.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
